# ---------- 运行模式 ----------
# development | production
BOOKNAV_ENV=production

# 进程监听地址（容器内固定 :8080 即可；本机 go run 也可用 :8080）
BOOKNAV_HTTP_ADDR=:8080

# 数据目录（SQLite、上传、备份）。Docker 一般用 ./data
BOOKNAV_DATA_DIR=./data

# 会话密钥（务必改成足够长的随机串）
BOOKNAV_SECRET_KEY=change-me-to-a-long-random-string

# ---------- 首次启动管理员（库中已有用户后不会覆盖密码）----------
BOOKNAV_ADMIN_USERNAME=admin
BOOKNAV_ADMIN_EMAIL=admin@example.com
BOOKNAV_ADMIN_PASSWORD=admin123

# ---------- 日志 / Cookie ----------
BOOKNAV_ACCESS_LOG=true
# auto | true | false；HTTP 访问用 false，纯 HTTPS 可 true/auto
BOOKNAV_COOKIE_SECURE=false

# ---------- 本机前端开发（Vite）----------
# 生产同域部署请留空或删除本行
BOOKNAV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 本机 go run 托管前端构建产物时可选：
# BOOKNAV_STATIC_DIR=./apps/server/webdist

# ---------- 根目录 docker-compose.yml（一键拉镜像）----------
# 镜像标签与宿主机端口（compose 变量替换会读项目目录下的 .env）
BOOKNAV_IMAGE_TAG=latest
BOOKNAV_HOST_PORT=8989

# 与 compose 内 qdrant 服务通信（容器内部服务名）
BOOKNAV_QDRANT_URL=http://qdrant:6333

# Qdrant 数据目录（仅 compose 使用）
QDRANT_STORAGE_DIR=./data/qdrant
# 如需改宿主机映射，可取消注释：
# QDRANT_HOST_PORT=127.0.0.1:6333
# QDRANT_GRPC_HOST_PORT=127.0.0.1:6334
