BOOKNAV_ENV=production
BOOKNAV_HTTP_ADDR=:8080
BOOKNAV_DATA_DIR=/data
BOOKNAV_STATIC_DIR=/webdist
BOOKNAV_SECRET_KEY=booknav-prod-change-me-please-use-long-random
BOOKNAV_ADMIN_USERNAME=admin
BOOKNAV_ADMIN_EMAIL=admin@example.com
BOOKNAV_ADMIN_PASSWORD=admin123
BOOKNAV_CORS_ORIGINS=
BOOKNAV_ACCESS_LOG=true
# Session cookie Secure flag: auto (default) | true | false
# auto = Secure only when request is HTTPS (or X-Forwarded-Proto: https)
# Use false only if you force HTTP behind a misconfigured proxy
# BOOKNAV_COOKIE_SECURE=auto
